{
  "expo": {
    "name": "smartfarm",
    "slug": "smartfarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smartfarm_logo_quad.png",
    "scheme": "smartfarm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.smartfarm.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "br.com.smartfarm.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F0",
        "foregroundImage": "./assets/images/smartfarm_logo_quad.png",
        "backgroundImage": "./assets/images/smartfarm_logo_quad.png",
        "monochromeImage": "./assets/images/smartfarm_logo_quad.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-auth0",
        {
          "domain": "dev-wc5l2gt5dt84h8lu.us.auth0.com",
          "customScheme": "smartfarm"
        }
      ],
      "expo-secure-store",
      "react-native-wifi-reborn",
      "expo-location",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9120d64f-ab69-4e6d-a22c-8c7bee439cf0"
      }
    },
    "owner": "smartfarm-app"
  }
}
